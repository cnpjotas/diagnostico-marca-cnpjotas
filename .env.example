# Ambiente do Front-end (Diagnóstico de Marca Cnpjotas)
# Copie para `.env` e preencha conforme necessário.

# URL do Web App publicado no Google Apps Script (para salvar leads em planilha)
VITE_APPS_SCRIPT_URL=""

# Identificador da aplicação (usado no Apps Script)
VITE_APP_ID="diagnostico-marca-cnpjotas"

# Chave de SITE do Cloudflare Turnstile (Opcional - deixe vazio em desenvolvimento)
VITE_TURNSTILE_SITE_KEY=""

# Número do WhatsApp do Comercial da Cnpjotas (somente dígitos com DDI e DDD, ex: 5531999704837)
VITE_WHATSAPP_NUMBER="5531999704837"
